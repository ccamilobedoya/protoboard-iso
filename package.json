{
  "name": "protoboard-iso",
  "version": "0.2.0",
  "description": "Breadboard circuits laid out, checked, drawn in isometric SVG and simulated from a short JSON file. A learning kit, an MCP server and an agent skill.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccamilobedoya/protoboard-iso.git"
  },
  "homepage": "https://github.com/ccamilobedoya/protoboard-iso#readme",
  "bugs": {
    "url": "https://github.com/ccamilobedoya/protoboard-iso/issues"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./workspace": "./src/node/workspace.js",
    "./schema/*": "./schema/*"
  },
  "bin": {
    "protoboard-iso": "./bin/protoboard-iso.js"
  },
  "files": [
    "SKILL.md",
    "bin",
    "docs",
    "examples",
    "schema",
    "src"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "examples": "node scripts/render-examples.js",
    "preview": "node scripts/preview.js",
    "schemas": "node scripts/build-schemas.js",
    "layout-bench": "node scripts/layout-bench.js",
    "test:mcp": "npm --prefix mcp test",
    "mcp": "node mcp/server.js",
    "verify": "node scripts/verify.js",
    "setup": "node scripts/setup.js",
    "lint": "biome lint .",
    "coverage": "c8 npm test",
    "knip": "knip --no-progress",
    "dupes": "jscpd --config .jscpd.json",
    "options": "node scripts/project-options.js",
    "context-size": "node scripts/context-size.js",
    "docs-index": "node scripts/docs-index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "breadboard",
    "protoboard",
    "isometric",
    "svg",
    "electronics",
    "education",
    "agent-skill",
    "circuit",
    "simulation",
    "mcp",
    "claude-skill"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@resvg/resvg-js": "^2.6.2",
    "c8": "^12.0.0",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.2",
    "knip": "^6.44.0"
  }
}
