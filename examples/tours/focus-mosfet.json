    { "at": 13000, "do": "land", "part": "Q1" },
    { "at": 14800, "do": "frame", "target": "parts", "move": "travel" },
    { "at": 14800, "do": "assemble", "gap": 600 },
    { "at": 21000, "do": "caption", "text": { "en": "S1 pressed, the LED lights", "es": "Con S1 apretado, el LED se enciende" } }
