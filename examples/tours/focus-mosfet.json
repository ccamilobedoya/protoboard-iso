    { "at": 3200, "do": "pin", "mark": "Q1" },
    { "at": 4800, "do": "symbol", "part": "Q1", "on": true },

    { "at": 6000, "do": "pin", "off": true },
    { "at": 6000, "do": "symbol", "on": false },
