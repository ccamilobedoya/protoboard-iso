{
  "$schema": "../../schema/timeline.schema.json",
  "circuit": "mosfet-switch",
  "format": "vertical",
  "steps": [
    { "at": 0, "do": "scene", "mode": "part", "part": "Q1", "zoom": 1.6 },
    { "at": 0, "do": "caption", "text": "IRLZ44N", "line": { "en": "A switch its gate's voltage opens", "es": "Un interruptor que abre el voltaje de su compuerta" } },
    { "at": 1400, "do": "frame", "target": "Q1" },

    { "at": 2000, "do": "pin", "pin": "Q1.G" },
    { "at": 2400, "do": "pin", "pin": "Q1.D" },
    { "at": 2800, "do": "pin", "pin": "Q1.S" },
    { "at": 3600, "do": "caption", "text": { "en": "Which leg is which", "es": "Cuál pata es cuál" } },
    { "at": 3600, "do": "pin", "mark": "Q1" },
    { "at": 5400, "do": "caption", "text": { "en": "Its symbol", "es": "Su símbolo" }, "line": { "en": "The gate does not touch the channel", "es": "La compuerta no toca el canal" } },
    { "at": 5400, "do": "symbol", "part": "Q1", "on": true },

    { "at": 7800, "do": "pin", "off": true },
    { "at": 7800, "do": "symbol", "on": false },
    { "at": 7800, "do": "bench", "part": "Q1", "on": true },
    { "at": 7800, "do": "inside", "part": "Q1", "on": true },
    { "at": 7800, "do": "caption", "text": { "en": "On the bench", "es": "En el banco" }, "line": { "en": "No gate voltage, no channel", "es": "Sin voltaje en la compuerta, no hay canal" } },
    { "at": 10000, "do": "caption", "text": { "en": "Press S1", "es": "Al apretar S1" }, "line": { "en": "the gate rises and the channel opens", "es": "la compuerta sube y el canal se abre" } },
    { "at": 10400, "do": "set", "part": "S1", "field": "pressed", "value": true },
    { "at": 10400, "do": "flow", "on": true, "ramp": 600 },
    { "at": 13200, "do": "caption", "text": { "en": "The gate takes no current", "es": "La compuerta no se lleva corriente" }, "line": { "en": "its voltage is all it needs", "es": "le basta con su voltaje" } },

    { "at": 16000, "do": "bench", "on": false },
    { "at": 16000, "do": "inside", "on": false },
    { "at": 16000, "do": "caption", "text": { "en": "On the breadboard", "es": "En la protoboard" }, "line": { "en": "The circuit builds itself around it", "es": "El circuito se arma a su alrededor" } },
    { "at": 16000, "do": "land", "part": "Q1" },
    { "at": 17800, "do": "frame", "target": "parts", "move": "travel" },
    { "at": 17800, "do": "assemble", "gap": 600 },

    { "at": 25000, "do": "caption", "text": { "en": "Let go of S1", "es": "Al soltar S1" }, "line": { "en": "the gate falls and the LED goes out", "es": "la compuerta baja y el LED se apaga" } },
    { "at": 25000, "do": "focus", "parts": ["Q1", "D1"], "move": "arrival" },
    { "at": 25500, "do": "set", "part": "S1", "field": "pressed", "value": false },
    { "at": 27500, "do": "set", "part": "S1", "field": "pressed", "value": true },
    { "at": 27500, "do": "caption", "text": { "en": "Press it again", "es": "Al apretarlo otra vez" }, "line": { "en": "the LED lights", "es": "el LED se enciende" } },
    { "at": 27900, "do": "value", "part": "D1", "field": "current", "label": { "en": "through the LED", "es": "por el LED" } },

    { "at": 30500, "do": "focus", "parts": [], "move": "arrival" },
    { "at": 30500, "do": "caption", "text": { "en": "A voltage", "es": "Un voltaje" }, "line": { "en": "opens and shuts the way", "es": "abre y cierra el paso" } }
  ]
}
