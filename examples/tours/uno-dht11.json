{
  "$schema": "../../schema/timeline.schema.json",
  "circuit": "uno-dht11",
  "format": "vertical",
  "steps": [
    { "at": 0, "do": "frame", "target": "board", "move": "cut" },
    { "at": 0, "do": "caption", "text": { "en": "A DHT11 tells an Arduino the temperature and the humidity", "es": "Un DHT11 le dice a un Arduino la temperatura y la humedad" } },
    { "at": 0, "do": "gauge", "environment": "temperature", "on": true, "min": 0, "max": 50 },
    { "at": 0, "do": "label", "part": "U2", "text": { "en": "DHT11", "es": "DHT11" } },
    { "at": 2500, "do": "focus", "parts": ["U2"] },
    { "at": 2500, "do": "frame", "target": "U2", "zoom": 0.8, "move": "arrival" },
    { "at": 2500, "do": "caption", "text": { "en": "One data pin, S: the library asks, it answers", "es": "Un solo pin de datos, S: pregunta y respuesta" } },
    { "at": 6000, "do": "focus", "parts": ["U1", "U2"] },
    { "at": 6000, "do": "frame", "target": ["U1", "U2"], "zoom": 0.8, "move": "travel" },
    { "at": 6000, "do": "caption", "text": { "en": "Every 2 s the sketch prints T: 24.00 C  H: 41.00 %", "es": "Cada 2 s el programa imprime T: 24.00 C  H: 41.00 %" }, "em": { "en": "Every 2 s", "es": "Cada 2 s" } },
    { "at": 10000, "do": "caption", "text": { "en": "It gets warmer: from 24 to 31 °C", "es": "Se pone más cálido: de 24 a 31 °C" } },
    { "at": 10000, "do": "set", "environment": "temperature", "value": 31, "move": "travel", "ms": 1800 },
    { "at": 13500, "do": "caption", "text": { "en": "The line changes at the next read, every 2 s", "es": "La línea cambia en la siguiente lectura, cada 2 s" }, "em": { "en": "every 2 s", "es": "cada 2 s" } },
    { "at": 17500, "do": "gauge", "environment": "humidity", "on": true, "min": 20, "max": 90 },
    { "at": 17500, "do": "caption", "text": { "en": "And more humid: from 41 to 70 %", "es": "Y más húmedo: de 41 a 70 %" } },
    { "at": 17500, "do": "set", "environment": "humidity", "value": 70, "move": "travel", "ms": 1800 },
    { "at": 21500, "do": "focus", "parts": ["U2"] },
    { "at": 21500, "do": "caption", "text": { "en": "Whole degrees and percent: ±2 °C and ±5 %", "es": "Grados y porcentaje enteros: ±2 °C y ±5 %" } },
    { "at": 25500, "do": "frame", "target": ["U1", "U2"], "zoom": 0.8, "move": "travel" },
    { "at": 25500, "do": "caption", "text": { "en": "A failed read is NaN: isnan() prints fail", "es": "Si falla da NaN: isnan() imprime fail" } },
    { "at": 30000, "do": "focus", "parts": [] }
  ]
}
