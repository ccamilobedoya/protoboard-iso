    { "at": 3200, "do": "pin", "mark": "D1" },
    { "at": 5000, "do": "caption", "text": { "en": "Its symbol", "es": "Su símbolo" }, "line": { "en": "A diode with a bent bar", "es": "Un diodo con la barra doblada" } },
    { "at": 5000, "do": "symbol", "part": "D1", "on": true },

    { "at": 7400, "do": "pin", "off": true },
    { "at": 7400, "do": "symbol", "on": false },
    { "at": 7400, "do": "bench", "part": "D1", "on": true },
    { "at": 7400, "do": "caption", "text": { "en": "On the bench", "es": "En el banco" }, "line": { "en": "It holds its voltage in reverse", "es": "Mantiene su voltaje en inversa" } },
