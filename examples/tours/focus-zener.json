    { "at": 21000, "do": "set", "part": "R2", "field": "resistance", "value": 470, "move": "travel", "ms": 1500 },
    { "at": 23200, "do": "caption", "text": { "en": "The voltage across it", "es": "El voltaje en sus patas" } },
    { "at": 23600, "do": "value", "part": "D1", "field": "voltage", "label": { "en": "across the Zener", "es": "en el Zener" } },

    { "at": 26400, "do": "focus", "parts": [], "move": "arrival" },
    { "at": 26400, "do": "caption", "text": { "en": "A Zener", "es": "Un Zener" }, "line": { "en": "holds the voltage steady", "es": "mantiene firme el voltaje" } }
