{
  "$schema": "../../schema/timeline.schema.json",
  "circuit": "lm35-comparator",
  "format": "vertical",
  "steps": [
    { "at": 0, "do": "frame", "target": "board", "move": "cut" },
    { "at": 0, "do": "caption", "text": { "en": "The LM35 gives 10 mV per degree", "es": "El LM35 da 10 mV por cada grado" } },
    { "at": 0, "do": "gauge", "environment": "temperature", "on": true },
    { "at": 2200, "do": "frame", "target": "U2", "move": "arrival" },
    { "at": 2200, "do": "focus", "parts": ["U2"] },
    { "at": 2200, "do": "flow", "on": true, "ramp": 600 },
    { "at": 2200, "do": "value", "part": "U2", "field": "vout", "label": { "en": "LM35 output", "es": "salida del LM35" } },
    { "at": 4800, "do": "frame", "target": ["R1", "R2"], "move": "travel" },
    { "at": 4800, "do": "focus", "parts": ["R1", "R2"] },
    { "at": 4800, "do": "caption", "text": { "en": "A divider sets the reference", "es": "Un divisor fija la referencia" } },
    { "at": 4800, "do": "value", "part": "R2", "field": "voltage", "label": { "en": "reference", "es": "referencia" } },
    { "at": 7600, "do": "frame", "target": ["U1", "D1"], "move": "travel" },
    { "at": 7600, "do": "focus", "parts": ["U1", "D1"] },
    { "at": 7600, "do": "caption", "text": { "en": "Cold, the comparator keeps the LED off", "es": "Con frío, el LED se mantiene apagado" } },
    { "at": 7600, "do": "value", "part": "D1", "field": "current", "label": { "en": "through the LED", "es": "por el LED" } },
    { "at": 10400, "do": "frame", "target": "U2", "move": "travel" },
    { "at": 10400, "do": "focus", "parts": ["U2"] },
    { "at": 10400, "do": "caption", "text": { "en": "Now it warms up: from 25 to 60 °C", "es": "Ahora se calienta: de 25 a 60 °C" } },
    { "at": 10400, "do": "set", "environment": "temperature", "value": 60, "move": "travel", "ms": 1800 },
    { "at": 13400, "do": "caption", "text": { "en": "The LM35's output rises", "es": "La salida del LM35 sube" } },
    { "at": 13400, "do": "value", "part": "U2", "field": "vout", "label": { "en": "LM35 output", "es": "salida del LM35" } },
    { "at": 16000, "do": "frame", "target": ["U1", "D1"], "move": "travel" },
    { "at": 16000, "do": "focus", "parts": ["U1", "D1"] },
    { "at": 16000, "do": "caption", "text": { "en": "It passes the reference: the LED lights", "es": "Pasa la referencia: el LED enciende" } },
    { "at": 16000, "do": "value", "part": "D1", "field": "current", "label": { "en": "through the LED", "es": "por el LED" } },
    { "at": 19200, "do": "caption", "text": { "en": "It cools down and the LED goes out", "es": "Se enfría y el LED se apaga" } },
    { "at": 19200, "do": "set", "environment": "temperature", "value": 25, "move": "travel", "ms": 1800 },
    { "at": 22400, "do": "frame", "target": "board", "move": "travel" },
    { "at": 22400, "do": "caption", "text": { "en": "Try it in the page: move the temperature", "es": "Pruébalo: mueve la temperatura" } },
    { "at": 24400, "do": "focus", "parts": [] }
  ]
}
