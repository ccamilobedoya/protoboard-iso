{
  "$schema": "../../schema/timeline.schema.json",
  "circuit": "ldr-comparator",
  "format": "vertical",
  "steps": [
    { "at": 0, "do": "frame", "target": "board", "move": "cut" },
    { "at": 0, "do": "caption", "text": { "en": "A comparator that measures light", "es": "Un comparador que mide la luz" } },
    { "at": 0, "do": "gauge", "environment": "light", "on": true, "min": 1, "max": 1000 },
    { "at": 2200, "do": "frame", "target": ["LDR1", "R1"], "move": "arrival" },
    { "at": 2200, "do": "focus", "parts": ["LDR1", "R1"] },
    { "at": 2200, "do": "flow", "on": true, "ramp": 600 },
    { "at": 2200, "do": "caption", "text": { "en": "The light sets the input voltage", "es": "La luz fija el voltaje de entrada" } },
    { "at": 2200, "do": "value", "part": "R1", "field": "voltage", "label": { "en": "comparator input", "es": "entrada del comparador" } },
    { "at": 5000, "do": "frame", "target": ["U1", "D1"], "move": "travel" },
    { "at": 5000, "do": "focus", "parts": ["U1", "D1"] },
    { "at": 5000, "do": "caption", "text": { "en": "With light, the LED stays off", "es": "Con luz, el LED está apagado" } },
    { "at": 5000, "do": "value", "part": "D1", "field": "current", "label": { "en": "through the LED", "es": "por el LED" } },
    { "at": 7800, "do": "frame", "target": ["LDR1", "R1"], "move": "travel" },
    { "at": 7800, "do": "focus", "parts": ["LDR1", "R1"] },
    { "at": 7800, "do": "caption", "text": { "en": "The light goes out: from 300 to 10 lx", "es": "Se apaga la luz: de 300 a 10 lx" } },
    { "at": 7800, "do": "set", "environment": "light", "value": 10, "move": "travel", "ms": 1800 },
    { "at": 10800, "do": "caption", "text": { "en": "The input falls below the reference", "es": "La entrada baja de la referencia" } },
    { "at": 10800, "do": "value", "part": "R1", "field": "voltage", "label": { "en": "comparator input", "es": "entrada del comparador" } },
    { "at": 13600, "do": "frame", "target": ["U1", "D1"], "move": "travel" },
    { "at": 13600, "do": "focus", "parts": ["U1", "D1"] },
    { "at": 13600, "do": "caption", "text": { "en": "The output pulls down and the LED lights", "es": "La salida tira abajo y el LED enciende" } },
    { "at": 13600, "do": "value", "part": "D1", "field": "current", "label": { "en": "through the LED", "es": "por el LED" } },
    { "at": 17000, "do": "caption", "text": { "en": "Light again: the LED goes out", "es": "Con luz otra vez, se apaga" } },
    { "at": 17000, "do": "set", "environment": "light", "value": 300, "move": "travel", "ms": 1800 },
    { "at": 20500, "do": "frame", "target": "board", "move": "travel" },
    { "at": 20500, "do": "caption", "text": { "en": "Try it in the page: move the light", "es": "Pruébalo en la página: mueve la luz" } },
    { "at": 22500, "do": "focus", "parts": [] }
  ]
}
