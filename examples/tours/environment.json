{
  "$schema": "../../schema/timeline.schema.json",
  "circuit": "environment",
  "format": "vertical",
  "steps": [
    { "at": 0, "do": "frame", "target": "board", "move": "cut" },
    { "at": 0, "do": "caption", "text": { "en": "Sensors read the environment", "es": "Los sensores leen el ambiente" } },
    { "at": 0, "do": "gauge", "environment": "light", "on": true },
    { "at": 1800, "do": "caption", "text": { "en": "With little light, the comparator lights the LED", "es": "Con poca luz, el comparador enciende el LED" } },
    { "at": 1800, "do": "focus", "parts": ["LDR1", "U1", "D1"] },
    { "at": 1800, "do": "frame", "target": ["LDR1", "D1"], "move": "arrival" },
    { "at": 4000, "do": "caption", "text": { "en": "The room goes dark: from 300 to 5 lx", "es": "El cuarto se oscurece: de 300 a 5 lx" } },
    { "at": 4000, "do": "set", "environment": "light", "value": 5, "move": "travel", "ms": 1800 },
    { "at": 6800, "do": "value", "part": "D1", "field": "current", "label": { "en": "through the LED", "es": "por el LED" } },
    { "at": 9000, "do": "caption", "text": { "en": "Now it warms up: from 25 to 60 °C", "es": "Ahora se calienta: de 25 a 60 °C" } },
    { "at": 9000, "do": "gauge", "environment": "temperature", "on": true },
    { "at": 9000, "do": "focus", "parts": ["TH1", "U2"] },
    { "at": 9000, "do": "frame", "target": ["TH1", "U2"], "move": "travel" },
    { "at": 11000, "do": "set", "environment": "temperature", "value": 60, "move": "travel", "ms": 1800 },
    { "at": 13800, "do": "caption", "text": { "en": "The LM35 gives 10 mV per degree", "es": "El LM35 da 10 mV por grado" } },
    { "at": 13800, "do": "value", "part": "U2", "field": "vout", "label": { "en": "LM35 output", "es": "salida del LM35" } },
    { "at": 17000, "do": "frame", "target": "board", "move": "travel" },
    { "at": 17000, "do": "caption", "text": { "en": "Every sensor reads the same light and temperature", "es": "Todos los sensores leen la misma luz y temperatura" } },
    { "at": 19000, "do": "focus", "parts": [] }
  ]
}
