{
  "$schema": "../../schema/timeline.schema.json",
  "circuit": "npn-switch",
  "format": "vertical",
  "steps": [
    { "at": 0, "do": "scene", "mode": "part", "part": "Q1", "zoom": 1.6 },
    { "at": 0, "do": "caption", "text": "2N2222A", "line": { "en": "A tap of current that a smaller current opens", "es": "Un grifo de corriente que abre otra más pequeña" } },
    { "at": 1400, "do": "frame", "target": "Q1" },

    { "at": 2000, "do": "pin", "pin": "Q1.E" },
    { "at": 2400, "do": "pin", "pin": "Q1.B" },
    { "at": 2800, "do": "pin", "pin": "Q1.C" },
    { "at": 3600, "do": "caption", "text": { "en": "Which leg is which", "es": "Cuál pata es cuál" } },
    { "at": 3600, "do": "pin", "mark": "Q1" },
    { "at": 5400, "do": "caption", "text": { "en": "Its symbol", "es": "Su símbolo" }, "line": { "en": "The same three legs in a schematic", "es": "Las mismas tres patas en un esquema" } },
    { "at": 5400, "do": "symbol", "part": "Q1", "on": true },

    { "at": 7800, "do": "pin", "off": true },
    { "at": 7800, "do": "symbol", "on": false },
    { "at": 7800, "do": "bench", "part": "Q1", "on": true },
    { "at": 7800, "do": "inside", "part": "Q1", "on": true },
    { "at": 7800, "do": "caption", "text": { "en": "On the bench", "es": "En el banco" }, "line": { "en": "No current into the base: the collector is shut", "es": "Sin corriente en la base, el colector no conduce" } },
    { "at": 10000, "do": "caption", "text": { "en": "Press S1", "es": "Al apretar S1" }, "line": { "en": "a small base current opens a large one", "es": "una corriente pequeña en la base abre una grande" } },
    { "at": 10400, "do": "set", "part": "S1", "field": "pressed", "value": true },
    { "at": 10400, "do": "flow", "on": true, "ramp": 600 },
    { "at": 13000, "do": "caption", "text": { "en": "A bigger base resistor", "es": "Una resistencia de base mayor" }, "line": { "en": "less base current, less collector current", "es": "menos corriente de base, menos de colector" } },
    { "at": 13400, "do": "set", "part": "R1", "field": "resistance", "value": 100000, "move": "travel", "ms": 1800 },
    { "at": 16200, "do": "set", "part": "R1", "field": "resistance", "value": 1000, "move": "travel", "ms": 1200 },

    { "at": 18000, "do": "bench", "on": false },
    { "at": 18000, "do": "inside", "on": false },
    { "at": 18000, "do": "caption", "text": { "en": "On the breadboard", "es": "En la protoboard" }, "line": { "en": "The circuit builds itself around it", "es": "El circuito se arma a su alrededor" } },
    { "at": 18000, "do": "land", "part": "Q1" },
    { "at": 19800, "do": "frame", "target": "parts", "move": "travel" },
    { "at": 19800, "do": "assemble", "gap": 600 },

    { "at": 25500, "do": "caption", "text": { "en": "Let go of S1", "es": "Al soltar S1" }, "line": { "en": "no base current, the LED goes out", "es": "sin corriente de base, el LED se apaga" } },
    { "at": 25500, "do": "focus", "parts": ["Q1", "D1"], "move": "arrival" },
    { "at": 26000, "do": "set", "part": "S1", "field": "pressed", "value": false },
    { "at": 28000, "do": "set", "part": "S1", "field": "pressed", "value": true },
    { "at": 28000, "do": "caption", "text": { "en": "Press it again", "es": "Al apretarlo otra vez" }, "line": { "en": "the LED lights", "es": "el LED se enciende" } },
    { "at": 28400, "do": "value", "part": "D1", "field": "current", "label": { "en": "through the LED", "es": "por el LED" } },

    { "at": 31000, "do": "focus", "parts": [], "move": "arrival" },
    { "at": 31000, "do": "caption", "text": { "en": "A small current", "es": "Una corriente pequeña" }, "line": { "en": "in charge of a large one", "es": "manda sobre una grande" } }
  ]
}
