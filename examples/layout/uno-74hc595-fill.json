{
 "title": {
  "en": "UNO filling eight LEDs through a 74HC595",
  "es": "UNO que llena ocho LED con un 74HC595"
 },
 "parts": [
  {
   "id": "U1",
   "part": "UNO",
   "program": "// Fills the eight LEDs one by one, then empties them: a 74HC595 takes each byte with shiftOut.\nconst int DATA = 11;   // SER\nconst int CLOCK = 12;  // SRCLK\nconst int LATCH = 8;   // RCLK\nint lit = 0;\n\nvoid setup() {\n  pinMode(DATA, OUTPUT);\n  pinMode(CLOCK, OUTPUT);\n  pinMode(LATCH, OUTPUT);\n}\n\nvoid loop() {\n  // lit LEDs from QA up: 0, 1, 3, 7 ... 255 (MSBFIRST puts bit 0 on QA)\n  int value = (1 << lit) - 1;\n  digitalWrite(LATCH, LOW);\n  shiftOut(DATA, CLOCK, MSBFIRST, value);\n  digitalWrite(LATCH, HIGH);\n  lit = (lit + 1) % 9;\n  delay(200);\n}\n"
  },
