{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.js",
        "src/page/client/live-page.js",
        "src/page/client/static-page.js",
        ".claude/hooks/*.js",
        "test/**/*.test.js"
      ],
      "project": [
        "bin/**/*.js",
        "scripts/**/*.js",
        "src/**/*.js",
        "test/**/*.js",
        ".claude/hooks/*.js"
      ]
    },
    "mcp": {
      "entry": [
        "kit-worker.js",
        "test/**/*.test.js"
      ],
      "project": [
        "**/*.js"
      ]
    }
  },
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "gitleaks"
  ]
}
