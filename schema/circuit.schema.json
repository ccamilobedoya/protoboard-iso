{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "circuit.schema.json",
  "title": "protoboard-iso circuit",
  "type": "object",
  "required": [
    "parts"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "description": "Bumped by every change made through apply/undo"
    },
    "title": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "One string per language code, e.g. { \"en\": \"…\", \"es\": \"…\" }"
        }
      ]
    },
    "lang": {
      "enum": [
        "en",
        "es"
      ],
      "description": "Language of everything made from this circuit: drawing labels, the page, messages. A language asked for explicitly (--lang, MCP lang) wins."
    },
    "board": {
      "enum": [
        "bb830",
        "bb400"
      ]
    },
    "view": {
      "enum": [
        "front",
        "back",
        "front-left",
        "back-right"
      ]
    },
    "clearance": {
      "type": "number",
      "minimum": 0,
      "description": "Minimum gap between bodies, mm"
    },
    "netLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "supplies": {
      "type": "array",
      "description": "Simulation: where the power comes from. The first supply's negative is ground (0 V).",
      "items": {
        "type": "object",
        "required": [
          "voltage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "e.g. V1"
          },
          "kind": {
            "enum": [
              "bench",
              "battery"
            ],
            "description": "battery: internal resistance 0.25 Ω per 1.5 V cell unless given"
          },
          "voltage": {
            "type": "number",
            "minimum": 0,
            "description": "volts"
          },
          "positive": {
            "type": "string",
            "description": "hole or node of the + lead, default \"T+\""
          },
          "negative": {
            "type": "string",
            "description": "hole or node of the − lead, default \"T-\""
          },
          "currentLimit": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "bench supply current limit, amperes (constant current above it)"
          },
          "internalResistance": {
            "type": "number",
            "minimum": 0,
            "description": "ohms"
          }
        },
        "additionalProperties": false
      }
    },
    "page": {
      "type": "object",
      "description": "The embeddable page out/<name>.html",
      "properties": {
        "results": {
          "type": "boolean",
          "description": "Add a button that shows the simulation results (hidden until pressed)"
        },
        "flow": {
          "type": "boolean",
          "description": "Add the current layer: everything dimmed, strips shown, moving dots (needs supplies)"
        },
        "focus": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Parts in focus when the page opens (the ones being explained)"
        }
      },
      "additionalProperties": false
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/part"
      }
    }
  },
  "$defs": {
    "part": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "anyOf": [
        {
          "required": [
            "pins"
          ]
        },
        {
          "required": [
            "pin1"
          ]
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique name, e.g. R1"
        },
        "type": {
          "enum": [
            "resistor",
            "capacitor",
            "potentiometer",
            "diode",
            "led",
            "mosfet",
            "bjt",
            "ic",
            "button",
            "wire"
          ]
        },
        "pins": {
          "description": "Holes for the leads: a list in the part's pin order, or an object by pin name. Holes: a1…j63, rails T+3, B-12…",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "minProperties": 2
            }
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "\"330\", \"4k7\", \"100n\", \"470u\""
        },
        "tolerance": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "resistor: \"5%\", \"1%\""
        },
        "bands": {
          "enum": [
            4,
            5
          ]
        },
        "power": {
          "type": "string",
          "description": "resistor: \"1/8\", \"1/4\", \"1/2\", \"1\""
        },
        "kind": {
          "enum": [
            "ceramic",
            "electrolytic"
          ]
        },
        "voltage": {
          "type": "number"
        },
        "diameter": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "color": {
          "type": "string"
        },
        "size": {
          "enum": [
            3,
            5
          ]
        },
        "part": {
          "type": "string",
          "description": "Part number for diode, mosfet, bjt (see src/parts/db.js)"
        },
        "package": {
          "type": "string"
        },
        "pinNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "marking": {
          "type": "string"
        },
        "style": {
          "enum": [
            "arc",
            "flat"
          ]
        },
        "pin1": {
          "type": "string",
          "description": "DIP chips: hole of pin 1 (row e or f); the other pins follow"
        },
        "position": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "potentiometer wiper position"
        },
        "pressed": {
          "type": "boolean",
          "description": "button state"
        },
        "description": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "One string per language code, e.g. { \"en\": \"…\", \"es\": \"…\" }"
            }
          ],
          "description": "How the part is used in this circuit, shown in its card in the page. A plain string is shown as it is in every language; { \"en\": …, \"es\": … } is shown in the page language. Leave it out when the learner should find it out."
        },
        "model": {
          "type": "object",
          "description": "Simulation: overrides the typical model, e.g. an LED measured at 20 mA { \"vf\": 2.95 } (see src/sim/models.js)"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
