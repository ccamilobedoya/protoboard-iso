{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "circuit.schema.json",
  "title": "protoboard-iso circuit",
  "type": "object",
  "required": [
    "parts"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "description": "Bumped by every change made through apply/undo"
    },
    "title": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "One string per language code, e.g. { \"en\": \"…\", \"es\": \"…\" }"
        }
      ]
    },
    "lang": {
      "enum": [
        "en",
        "es"
      ],
      "description": "Language of everything made from this circuit: drawing labels, the page, messages. A language asked for explicitly (--lang, MCP lang) wins."
    },
    "board": {
      "enum": [
        "bb830",
        "bb400"
      ]
    },
    "view": {
      "enum": [
        "front",
        "back",
        "front-left",
        "back-right"
      ]
    },
    "clearance": {
      "type": "number",
      "minimum": 0,
      "description": "Minimum gap between bodies, mm"
    },
    "netLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "supplies": {
      "type": "array",
      "description": "Simulation: where the power comes from, besides battery parts. The first supply's negative is ground (0 V); with none, the first battery part's.",
      "items": {
        "type": "object",
        "anyOf": [
          {
            "required": [
              "voltage"
            ]
          },
          {
            "required": [
              "format"
            ]
          },
          {
            "required": [
              "chemistry"
            ]
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "e.g. V1"
          },
          "kind": {
            "enum": [
              "bench",
              "battery"
            ],
            "description": "battery: like a battery part (format, chemistry, cells, charge), or only a voltage (0.25 Ω per 1.5 V cell unless given)"
          },
          "format": {
            "enum": [
              "18650",
              "AA",
              "AAA",
              "9V",
              "pouch"
            ]
          },
          "chemistry": {
            "enum": [
              "alkaline",
              "nimh",
              "li-ion",
              "lipo",
              "lifepo4"
            ]
          },
          "cells": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "charge": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "capacity": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "voltage": {
            "type": "number",
            "minimum": 0,
            "description": "volts"
          },
          "positive": {
            "type": "string",
            "description": "hole or node of the + lead, default \"T+\""
          },
          "negative": {
            "type": "string",
            "description": "hole or node of the − lead, default \"T-\""
          },
          "currentLimit": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "bench supply current limit, amperes (constant current above it)"
          },
          "internalResistance": {
            "type": "number",
            "minimum": 0,
            "description": "ohms"
          }
        },
        "additionalProperties": false
      }
    },
    "page": {
      "type": "object",
      "description": "The embeddable page out/<name>.html",
      "properties": {
        "results": {
          "type": "boolean",
          "description": "Simulation always on in the page: the tapped part shows its values on the board and in its card"
        },
        "flow": {
          "type": "boolean",
          "description": "Add the current layer: everything dimmed, strips shown, moving dots (needs supplies or a battery)"
        },
        "focus": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Parts in focus when the page opens (the ones being explained)"
        }
      },
      "additionalProperties": false
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/part"
      }
    }
  },
  "$defs": {
    "part": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "anyOf": [
        {
          "required": [
            "pins"
          ]
        },
        {
          "required": [
            "pin1"
          ]
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique name, e.g. R1"
        },
        "type": {
          "enum": [
            "resistor",
            "capacitor",
            "potentiometer",
            "diode",
            "zener",
            "bridge",
            "led",
            "mosfet",
            "bjt",
            "ic",
            "regulator",
            "button",
            "wire",
            "battery",
            "module",
            "inductor",
            "thermistor",
            "ldr",
            "buzzer",
            "header"
          ]
        },
        "pins": {
          "description": "Holes for the leads: a list in the part's pin order, or an object by pin name. Holes: a1…j63, rails T+3, B-12…",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "minProperties": 2
            }
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "\"330\", \"4k7\", \"100n\", \"470u\""
        },
        "tolerance": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "resistor: \"5%\", \"1%\""
        },
        "bands": {
          "enum": [
            4,
            5
          ]
        },
        "power": {
          "type": "string",
          "description": "resistor: \"1/8\", \"1/4\", \"1/2\", \"1\"; \"3\", \"5\", \"10\" draw a cement resistor"
        },
        "kind": {
          "enum": [
            "ceramic",
            "electrolytic"
          ]
        },
        "voltage": {
          "type": "number",
          "description": "electrolytic: rated volts; battery: measured open-circuit volts (wins over charge)"
        },
        "diameter": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "color": {
          "type": "string"
        },
        "size": {
          "enum": [
            3,
            5
          ]
        },
        "part": {
          "type": "string",
          "description": "Part number for diode, zener, bridge, mosfet, bjt, ic, regulator, ldr (see src/parts/db.js); module: ESP32-DEVKIT, ESP32-C3-SUPERMINI, UNO (see src/parts/modules.js)"
        },
        "package": {
          "type": "string"
        },
        "pinNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "marking": {
          "type": "string"
        },
        "style": {
          "enum": [
            "arc",
            "flat",
            "knob",
            "trimmer"
          ],
          "description": "wire: \"arc\" | \"flat\"; potentiometer: \"knob\" (default) | \"trimmer\" (multi-turn 3296W)"
        },
        "pin1": {
          "type": "string",
          "description": "DIP chips: hole of pin 1 (row e or f); the other pins follow. Header: first pin, the others towards higher columns. Module straddling the channel (ESP32): hole of pin 1, the other row rowSpacing holes away"
        },
        "rowSpacing": {
          "type": "integer",
          "minimum": 4,
          "maximum": 12,
          "description": "module (ESP32 boards): holes between its two rows of pins; boards differ (DevKit default 9 = 0.9\")"
        },
        "wires": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "module UNO: colour of the Dupont lead of each pin, e.g. { \"D13\": \"yellow\" }"
        },
        "position": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "potentiometer wiper position"
        },
        "pressed": {
          "type": "boolean",
          "description": "button state"
        },
        "format": {
          "enum": [
            "18650",
            "AA",
            "AAA",
            "9V",
            "pouch"
          ],
          "description": "battery: AA, AAA, 18650, 9V or pouch (LiPo)"
        },
        "chemistry": {
          "enum": [
            "alkaline",
            "nimh",
            "li-ion",
            "lipo",
            "lifepo4"
          ],
          "description": "battery: default by format (AA/AAA alkaline, 18650 li-ion, pouch lipo)"
        },
        "cells": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "battery: cells (or 9 V blocks) in series; voltages add up"
        },
        "charge": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "battery: state of charge, 0 empty … 1 full; without it, the nominal voltage"
        },
        "capacity": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "battery: \"2000 mAh\" (a number is mAh); default by format"
        },
        "internalResistance": {
          "type": "number",
          "minimum": 0,
          "description": "battery: ohms, for the whole pack"
        },
        "switch": {
          "enum": [
            "on",
            "off"
          ],
          "description": "battery: a holder with a slide switch, and its position"
        },
        "side": {
          "enum": [
            "left",
            "right",
            "back",
            "front"
          ],
          "description": "battery: board edge it lies beside (default: the nearer side edge); module UNO: back (default) or front"
        },
        "offset": {
          "type": "number",
          "description": "battery, module UNO: shift along that edge, mm"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40,
          "description": "header: number of pins (place with pin1)"
        },
        "beta": {
          "type": "number",
          "description": "thermistor: B constant in kelvin (default 3950)"
        },
        "temperature": {
          "type": "number",
          "description": "thermistor: °C for the simulation (default 25)"
        },
        "light": {
          "type": "number",
          "minimum": 0,
          "description": "ldr: illuminance in lux for the simulation (default 100). Parts: GL5516, GL5528, GL5537, GL5539, GL5549"
        },
        "dcr": {
          "type": "number",
          "minimum": 0,
          "description": "inductor: winding resistance, ohms"
        },
        "current": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "inductor: rated current, amperes"
        },
        "resistance": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "buzzer: coil resistance (default 16 Ω)"
        },
        "description": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "One string per language code, e.g. { \"en\": \"…\", \"es\": \"…\" }"
            }
          ],
          "description": "How the part is used in this circuit, shown in its card in the page. A plain string is shown as it is in every language; { \"en\": …, \"es\": … } is shown in the page language. Leave it out when the learner should find it out."
        },
        "model": {
          "type": "object",
          "description": "Simulation: overrides the typical model, e.g. an LED measured at 20 mA { \"vf\": 2.95 } (see src/sim/models.js)"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
