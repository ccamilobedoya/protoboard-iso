{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "timeline.schema.json",
  "title": "protoboard-iso timeline",
  "description": "A tour of a circuit's page and the script of a video: written once, played the same every time.",
  "type": "object",
  "required": [
    "steps"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "circuit": {
      "type": "string",
      "description": "The circuit (or recipe) it tells"
    },
    "format": {
      "enum": [
        "vertical",
        "horizontal"
      ],
      "description": "The video: vertical 1080 × 1920 (default) or horizontal 1920 × 1080"
    },
    "theme": {
      "enum": [
        "light",
        "dark",
        "notebook",
        "stage"
      ],
      "description": "The page's theme in a recording: stage (default, the notebook at night), notebook (by day), light or dark (the bench). A link's ?theme= wins over this"
    },
    "steps": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "at",
              "do",
              "target"
            ],
            "properties": {
              "at": {
                "type": "number",
                "minimum": 0,
                "description": "ms from the start; steps with the same at start together"
              },
              "move": {
                "enum": [
                  "cut",
                  "arrival",
                  "travel",
                  "push",
                  "hit",
                  "breath",
                  "anticipation"
                ],
                "description": "cut 0 ms, arrival 600…900 ms, travel 1200…1800 ms, push 3000…8000 ms, hit 120…180 ms, breath 400…1200 ms, anticipation 600…900 ms"
              },
              "ms": {
                "type": "number",
                "minimum": 0,
                "description": "The move's duration, within its range (push needs it most); in an assemble, each part's"
              },
              "curve": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4,
                "description": "The move's own cubic-bezier [x1, y1, x2, y2] (x between 0 and 1), instead of the move's curve"
              },
              "do": {
                "const": "frame"
              },
              "target": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "id of a part (or a supply)"
                    },
                    "minItems": 1
                  }
                ],
                "description": "board, parts, here (the frame as it is), a part id or a list of part ids"
              },
              "zoom": {
                "type": "number",
                "minimum": 0.05,
                "maximum": 20,
                "description": "Closer in (above 1) or farther out (below 1), about the centre"
              },
              "pan": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -3,
                  "maximum": 3
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "Then moved by [x, y] shares of the frame: [0.2, 0] a fifth to the right, [0, -0.1] a tenth up"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "at",
              "do",
              "parts"
            ],
            "properties": {
              "at": {
                "type": "number",
                "minimum": 0,
                "description": "ms from the start; steps with the same at start together"
              },
              "move": {
                "enum": [
                  "cut",
                  "arrival",
                  "travel",
                  "push",
                  "hit",
                  "breath",
                  "anticipation"
                ],
                "description": "cut 0 ms, arrival 600…900 ms, travel 1200…1800 ms, push 3000…8000 ms, hit 120…180 ms, breath 400…1200 ms, anticipation 600…900 ms"
              },
              "ms": {
                "type": "number",
                "minimum": 0,
                "description": "The move's duration, within its range (push needs it most); in an assemble, each part's"
              },
              "curve": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4,
                "description": "The move's own cubic-bezier [x1, y1, x2, y2] (x between 0 and 1), instead of the move's curve"
              },
              "do": {
                "const": "focus"
              },
              "parts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "id of a part (or a supply)"
                },
                "description": "The parts brought forward; [] clears. With a move, the veil, strips and coordinates come in (or leave) along it"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "at",
              "do",
              "view"
            ],
            "properties": {
              "at": {
                "type": "number",
