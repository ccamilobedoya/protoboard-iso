{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ops.schema.json",
  "title": "protoboard-iso operations",
  "description": "A batch of operations, applied atomically (all or none).",
  "type": "array",
  "minItems": 1,
  "items": {
    "oneOf": [
      {
        "type": "object",
        "required": [
          "op",
          "part"
        ],
        "properties": {
          "op": {
            "const": "add"
          },
          "part": {
            "$ref": "circuit.schema.json#/$defs/part"
          },
          "index": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "op",
          "part"
        ],
        "properties": {
          "op": {
            "const": "remove"
          },
          "part": {
            "type": "string",
            "description": "id of an existing part"
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "op",
          "part",
          "pins"
        ],
        "properties": {
          "op": {
            "const": "move"
          },
          "part": {
            "type": "string",
            "description": "id of an existing part"
          },
          "pins": {
            "description": "Holes for the leads: a list in the part's pin order, or an object by pin name. Holes: a1…j63, rails T+3, B-12…",
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "minProperties": 2
              }
            ]
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "op",
          "part"
        ],
        "properties": {
          "op": {
            "const": "set"
          },
          "part": {
            "type": "string",
            "description": "id of an existing part"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "id"
              ]
            },
            {
              "required": [
                "pins"
              ]
            }
          ]
        },
        "minProperties": 3,
        "additionalProperties": true,
        "description": "Any part field except id and pins; null deletes the field"
      },
      {
        "type": "object",
        "required": [
          "op",
          "part",
          "to"
        ],
        "properties": {
          "op": {
            "const": "rename"
          },
          "part": {
            "type": "string",
            "description": "id of an existing part"
          },
          "to": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "op"
        ],
        "properties": {
          "op": {
            "const": "circuit"
          },
          "title": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "One string per language code, e.g. { \"en\": \"…\", \"es\": \"…\" }"
              }
            ]
          },
          "board": {
            "enum": [
              "bb830",
              "bb400"
            ]
          },
          "view": {
            "enum": [
              "front",
              "back",
              "front-left",
              "back-right"
            ]
          },
          "clearance": {
            "type": "number",
            "minimum": 0,
            "description": "Minimum gap between bodies, mm"
          },
          "netLabels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "minProperties": 2,
        "additionalProperties": false
      }
    ]
  }
}
