{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ops.schema.json",
  "title": "protoboard-iso operations",
  "description": "A batch of operations, applied atomically (all or none).",
  "type": "array",
  "minItems": 1,
  "items": {
    "oneOf": [
      {
        "type": "object",
        "required": [
          "op",
          "part"
        ],
        "properties": {
          "op": {
            "const": "add"
          },
          "part": {
            "$ref": "circuit.schema.json#/$defs/part"
          },
          "index": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "op",
          "part"
        ],
        "properties": {
          "op": {
            "const": "remove"
          },
          "part": {
            "type": "string",
            "description": "id of an existing part"
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "op",
          "part"
        ],
        "properties": {
          "op": {
            "const": "move"
          },
          "part": {
            "type": "string",
            "description": "id of an existing part"
          },
          "pins": {
            "description": "Holes for the leads: a list in the part's pin order, or an object by pin name. Holes: a1…j63, rails T+3, B-12…",
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "minProperties": 2
              }
            ]
          },
          "pin1": {
            "type": "string"
          }
        },
        "minProperties": 3,
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "op",
          "part"
        ],
        "properties": {
          "op": {
            "const": "set"
          },
          "part": {
            "type": "string",
            "description": "id of an existing part"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "id"
              ]
            },
            {
              "required": [
                "pins"
              ]
            },
            {
              "required": [
                "pin1"
              ]
            }
          ]
        },
        "minProperties": 3,
        "additionalProperties": true,
        "description": "Any part field except id and pins; null deletes the field"
      },
      {
        "type": "object",
        "required": [
          "op",
          "part",
          "to"
        ],
        "properties": {
          "op": {
            "const": "rename"
          },
          "part": {
            "type": "string",
            "description": "id of an existing part"
          },
          "to": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "op"
        ],
        "properties": {
          "op": {
            "const": "circuit"
          },
          "title": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "One string per language code, e.g. { \"en\": \"…\", \"es\": \"…\" }"
              }
            ]
          },
          "lang": {
            "enum": [
              "en",
              "es"
            ],
            "description": "Language of everything made from this circuit: drawing labels, the page, messages. A language asked for explicitly (--lang, MCP lang) wins."
          },
          "board": {
            "enum": [
              "bb830",
              "bb400"
            ]
          },
          "view": {
            "enum": [
              "front",
              "back",
              "front-left",
              "back-right"
            ]
          },
          "clearance": {
            "type": "number",
            "minimum": 0,
            "description": "Minimum gap between bodies, mm"
          },
          "netLabels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "supplies": {
            "type": "array",
            "description": "Simulation: where the power comes from, besides battery parts. The first supply's negative is ground (0 V); with none, the first battery part's.",
            "items": {
              "type": "object",
              "anyOf": [
                {
                  "required": [
                    "voltage"
                  ]
                },
                {
                  "required": [
                    "format"
                  ]
                },
                {
                  "required": [
                    "chemistry"
                  ]
                }
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "e.g. V1"
                },
                "kind": {
                  "enum": [
                    "bench",
                    "battery"
                  ],
                  "description": "battery: like a battery part (format, chemistry, cells, charge), or only a voltage (0.25 Ω per 1.5 V cell unless given)"
                },
                "format": {
                  "enum": [
                    "18650",
                    "AA",
                    "AAA",
                    "9V",
                    "pouch"
                  ]
                },
                "chemistry": {
                  "enum": [
                    "alkaline",
                    "nimh",
                    "li-ion",
                    "lipo",
                    "lifepo4"
                  ]
                },
                "cells": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "charge": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "capacity": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ]
                },
                "voltage": {
                  "type": "number",
                  "minimum": 0,
                  "description": "volts"
                },
                "positive": {
                  "type": "string",
                  "description": "hole or node of the + lead, default \"T+\""
                },
                "negative": {
                  "type": "string",
                  "description": "hole or node of the − lead, default \"T-\""
                },
                "currentLimit": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "bench supply current limit, amperes (constant current above it)"
                },
                "internalResistance": {
                  "type": "number",
                  "minimum": 0,
                  "description": "ohms"
                }
              },
              "additionalProperties": false
            }
          },
          "page": {
            "type": "object",
            "description": "The embeddable page out/<name>.html",
            "properties": {
              "results": {
                "type": "boolean",
                "description": "Simulation always on in the page: the tapped part shows its values on the board and in its card"
              },
              "flow": {
                "type": "boolean",
                "description": "Add the current layer: everything dimmed, strips shown, moving dots (needs supplies or a battery)"
              },
              "focus": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Parts in focus when the page opens (the ones being explained)"
              },
              "start": {
                "enum": [
                  "dc",
                  "zero"
                ],
                "description": "Live simulation (with results or flow): 'dc' opens at the DC values (default); 'zero' switches on at t = 0 with capacitors discharged and runs"
              }
            },
            "additionalProperties": false
          }
        },
        "minProperties": 2,
        "additionalProperties": false
      }
    ]
  }
}
